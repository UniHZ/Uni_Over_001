local function applyTheme(themeKey)
    local theme = Themes[themeKey]
    if not theme then return end

    CurrentTheme = themeKey
    MainFrame.BackgroundColor3 = theme.Main
    TitleBar.BackgroundColor3 = theme.Panel
    TabBar.BackgroundColor3 = theme.Panel
    TitleAccent.BackgroundColor3 = theme.Accent
    TitleText.TextColor3 = theme.Accent
    InfoText.BackgroundColor3 = theme.Panel
    InfoText.TextColor3 = theme.SubText
    RangeInfo.TextColor3 = theme.AccentLight
    InputLabel.TextColor3 = theme.SubText
    TargetInput.BackgroundColor3 = theme.Input
    MinIcon.TextColor3 = theme.Accent
    OpacityTrack.BackgroundColor3 = theme.Input
    OpacityFill.BackgroundColor3 = theme.Accent
    UIStroke.Color = theme.Accent

    -- Refresh tab buttons
    for i, btn in ipairs(tabButtons) do
        if i == activeTab then
            btn.BackgroundColor3 = theme.Accent
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = theme.Input
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
    end

    -- Refresh toggle buttons
    refreshAllToggleButtons()

    -- Refresh gradient palette for animated UIStroke
    gradientColors = {theme.Accent, theme.AccentLight, theme.Accent, theme.AccentLight}

    -- Reapply opacity after color change
    applyOpacity(currentOpacity)
end


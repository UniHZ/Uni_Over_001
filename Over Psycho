-- ==========================================
-- MINIMIZE / MAXIMIZE (DRAGGABLE ICON)
-- ==========================================
local isMinimized = false
local minDragState = {active = false, startMouse = nil, movedDist = 0, startPos = nil}

local function minimize()
    isMinimized = true
    MainFrame.Draggable = false
    MainFrame.Size = UDim2.new(0, 50, 0, 50)
    TitleBar.Visible = false
    TabBar.Visible = false
    for _, c in ipairs(tabContents) do c.Visible = false end
    InfoText.Visible = false
    MinIcon.Visible = true
end

local function maximize()
    isMinimized = false
    MainFrame.Draggable = true
    MainFrame.Size = UDim2.new(0, 320, 0, 300)
    TitleBar.Visible = true
    TabBar.Visible = true
    InfoText.Visible = true
    setActiveTab(activeTab)
    MinIcon.Visible = false
end

MinBtn.MouseButton1Click:Connect(minimize)

-- Drag detection for minimized icon
MinIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        minDragState.active = true
        minDragState.startMouse = input.Position
        minDragState.movedDist = 0
        minDragState.startPos = MainFrame.AbsolutePosition
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if minDragState.active then
        if input.UserInputType == Enum.UserInputType.MouseMovement
        or input.UserInputType == Enum.UserInputType.Touch then
            local delta = input.Position - minDragState.startMouse
            minDragState.movedDist = delta.Magnitude
            MainFrame.Position = UDim2.new(
                0, minDragState.startPos.X + delta.X,
                0, minDragState.startPos.Y + delta.Y
            )
        end
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        minDragState.active = false
    end
end)

MinIcon.MouseButton1Click:Connect(function()
    if minDragState.movedDist < 5 then
        maximize()
    end
end)


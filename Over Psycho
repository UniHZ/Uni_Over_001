-- ==========================================
-- OPACITY SLIDER LOGIC
-- ==========================================
local sliderDragging = false

local function updateOpacityFromX(x)
    local rel = math.clamp((x - OpacityTrack.AbsolutePosition.X) / OpacityTrack.AbsoluteSize.X, 0.3, 1.0)
    OpacityFill.Size = UDim2.new(rel, 0, 1, 0)
    OpacityKnob.Position = UDim2.new(rel, -7, 0.5, -7)
    OpacityLabel.Text = "UI OPACITY : " .. math.floor(rel * 100) .. "%"
    applyOpacity(rel)
end

OpacityTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
        updateOpacityFromX(input.Position.X)
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        updateOpacityFromX(input.Position.X)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)


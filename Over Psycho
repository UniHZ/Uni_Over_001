local opacityElements = {}
local function regOpacity(elem)
    table.insert(opacityElements, {elem = elem, base = elem.BackgroundTransparency})
end

regOpacity(MainFrame)
regOpacity(TitleBar)
regOpacity(TabBar)
regOpacity(InfoText)
regOpacity(TargetInput)
regOpacity(AddBtn)
for _, btn in ipairs(tabButtons) do regOpacity(btn) end
regOpacity(ToggleBossBtn)
regOpacity(ToggleEnemyBtn)
regOpacity(ToggleOpsBtn)
regOpacity(ToggleRaidBtn)
regOpacity(ToggleChestBtn)
regOpacity(ToggleAntiAFKBtn)
regOpacity(OpacityTrack)
regOpacity(OpacityFill)

local function applyOpacity(alpha)
    currentOpacity = alpha
    for _, t in ipairs(opacityElements) do
        if t.base < 1 then
            t.elem.BackgroundTransparency = 1 - ((1 - t.base) * alpha)
        end
    end
end


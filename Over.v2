-- ========== APPLY THEME ==========
function applyTheme(themeName)
    local t = Themes[themeName]
    if not t then return end
    Theme = t
    MainFrame.BackgroundColor3 = t.bg
    TitleBar.BackgroundColor3 = t.bgLight
    TabBar.BackgroundColor3 = t.bgLight
    InfoText.BackgroundColor3 = t.bgLight
    TitleText.TextColor3 = t.accent
    TitleAccent.BackgroundColor3 = t.accent
    CloseBtn.TextColor3 = t.accent
    MinIcon.TextColor3 = t.accent
    PriorityBtn.TextColor3 = t.accent
    ps.Color = t.accent
    pps.Color = t.accent
    TargetInput.BorderColor3 = t.accent
    SliderFill.BackgroundColor3 = t.accent

    for i, btn in ipairs(tabButtons) do
        if i == activeTab then
            btn.BackgroundColor3 = t.accent
        else
            btn.BackgroundColor3 = t.bgInput
        end
    end

    local allToggles = {
        {ToggleBossBtn, AutoKillBossEnabled},
        {ToggleEnemyBtn, AutoKillEnemyEnabled},
        {ToggleAutoAttackBtn, AutoAttackEnabled},
        {ToggleOpsBtn, AutoOpsEnabled},
        {ToggleRaidBtn, AutoRaidEnabled},
        {ToggleChestBtn, AutoChestEnabled},
        {ToggleGodBtn, GodModeEnabled},
        {ToggleAfkBtn, AntiAfkEnabled},
    }
    for _, pair in ipairs(allToggles) do
        if not pair[2] then
            pair[1].BackgroundColor3 = t.accent
        end
    end

    for name, data in pairs(themeButtons) do
        data.btn.BackgroundColor3 = t.bgInput
        data.btn.TextColor3 = t.accent
        data.stroke.Color = t.accent
        if name == themeName then
            data.btn.BackgroundColor3 = t.accent
            data.btn.TextColor3 = Color3.fromRGB(255, 255, 255)
            data.stroke.Color = Color3.fromRGB(255, 255, 255)
        end
    end
end

-- ========== OPACITY ==========
local function applyOpacity(v)
    UIOpacity = v
    OpacityLabel.Text = "UI OPACITY: " .. math.floor(v * 100) .. "%"
    MainFrame.BackgroundTransparency = 1 - v
    TitleBar.BackgroundTransparency = 1 - v
    TabBar.BackgroundTransparency = 1 - v
    InfoText.BackgroundTransparency = 1 - (v * 0.5)
end

-- Slider drag
local sliderDragging = false
SliderTrack.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = true
    end
end)
UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        sliderDragging = false
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if sliderDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local relX = input.Position.X - SliderTrack.AbsolutePosition.X
        local pct = math.clamp(relX / SliderTrack.AbsoluteSize.X, 0, 1)
        applyOpacity(0.3 + pct * 0.7)
        SliderFill.Size = UDim2.new(pct, 0, 1, 0)
        SliderKnob.Position = UDim2.new(pct, -7, 0.5, -7)
    end
end)

-- ========== DRAG MAIN (from TitleBar) ==========
local draggingMain = false
local dragStart, startPos

local function attachDrag(zone)
    zone.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            draggingMain = true
            dragStart = input.Position
            startPos = MainFrame.Position
        end
    end)
end

attachDrag(TitleBar)
attachDrag(TitleText)
attachDrag(TitleAccent)

-- MinIcon drag + click
local minDragging = false
local minWasDragged = false
local minDragStart, minDragPos

MinIcon.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        minDragging = true
        minWasDragged = false
        minDragStart = input.Position
        minDragPos = MainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if draggingMain and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
    if minDragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - minDragStart
        if delta.Magnitude > 6 then minWasDragged = true end
        MainFrame.Position = UDim2.new(minDragPos.X.Scale, minDragPos.X.Offset + delta.X, minDragPos.Y.Scale, minDragPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        draggingMain = false
        minDragging = false
    end
end)

-- ========== MIN/MAX ==========
local isMinimized = false

local function minimize()
    isMinimized = true
    MainFrame.Size = UDim2.new(0, 50, 0, 50)
    TitleBar.Visible = false
    TabBar.Visible = false
    for _, c in ipairs(tabContents) do c.Visible = false end
    InfoText.Visible = false
    MinIcon.Visible = true
end

local function maximize()
    isMinimized = false
    MainFrame.Size = UDim2.new(0, FRAME_W, 0, FRAME_H)
    TitleBar.Visible = true
    TabBar.Visible = true
    InfoText.Visible = true
    setActiveTab(activeTab)
    MinIcon.Visible = false
end

MinBtn.MouseButton1Click:Connect(minimize)
MinIcon.MouseButton1Click:Connect(function()
    if not minWasDragged then maximize() end
    minWasDragged = false
end)

-- ========== TOGGLE HANDLERS ==========
local function styleToggle(btn, enabled, label)
    btn.Text = label .. " : " .. (enabled and "ON" or "OFF")
    btn.BackgroundColor3 = enabled and Color3.fromRGB(50, 200, 50) or Theme.accent
end

ToggleBossBtn.MouseButton1Click:Connect(function()
    AutoKillBossEnabled = not AutoKillBossEnabled
    styleToggle(ToggleBossBtn, AutoKillBossEnabled, "INSTANT KILL BOSS")
end)

ToggleEnemyBtn.MouseButton1Click:Connect(function()
    AutoKillEnemyEnabled = not AutoKillEnemyEnabled
    styleToggle(ToggleEnemyBtn, AutoKillEnemyEnabled, "INSTANT KILL NPC")
end)

ToggleAutoAttackBtn.MouseButton1Click:Connect(function()
    AutoAttackEnabled = not AutoAttackEnabled
    styleToggle(ToggleAutoAttackBtn, AutoAttackEnabled, "AUTO ATTACK (MELEE)")
end)

ToggleOpsBtn.MouseButton1Click:Connect(function()
    AutoOpsEnabled = not AutoOpsEnabled
    styleToggle(ToggleOpsBtn, AutoOpsEnabled, "AUTO START OPS")
end)

ToggleRaidBtn.MouseButton1Click:Connect(function()
    AutoRaidEnabled = not AutoRaidEnabled
    styleToggle(ToggleRaidBtn, AutoRaidEnabled, "AUTO REPLAY RAID")
end)

ToggleChestBtn.MouseButton1Click:Connect(function()
    AutoChestEnabled = not AutoChestEnabled
    styleToggle(ToggleChestBtn, AutoChestEnabled, "AUTO OPEN CHEST")
end)

ToggleGodBtn.MouseButton1Click:Connect(function()
    GodModeEnabled = not GodModeEnabled
    styleToggle(ToggleGodBtn, GodModeEnabled, "GOD MODE")
end)

ToggleAfkBtn.MouseButton1Click:Connect(function()
    AntiAfkEnabled = not AntiAfkEnabled
    styleToggle(ToggleAfkBtn, AntiAfkEnabled, "ANTI AFK")
end)

AddBtn.MouseButton1Click:Connect(function()
    local newName = string.lower(TargetInput.Text):match("^%s*(.-)%s*$")
    if newName ~= "" then
        table.insert(BossNames, newName)
        table.insert(EnemyNames, newName)
        table.insert(getgenv().UniSc_CustomTargets, newName)
        InfoText.Text = "STATUS: ADDED TARGET\nNAME: " .. newName
        TargetInput.Text = ""
    else
        InfoText.Text = "STATUS: INPUT EMPTY"
    end
end)

local function Cleanup()
    isAlive = false
    if ScreenGui then ScreenGui:Destroy() end
    getgenv().UniSc_Persistent = nil
    getgenv().UniSc_GUI = nil
end
CloseBtn.MouseButton1Click:Connect(Cleanup)

-- ==========================================
-- LOGIKA AUTO START OPS
-- ==========================================
task.spawn(function()
    local FORCE_FIRE_TIMEOUT = 12
    local lastFire = 0
    local function isBossAlive()
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.ClassName == "Model" then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local nameLower = string.lower(obj.Name)
                    for _, bName in ipairs(BossNames) do
                        if string.find(nameLower, bName, 1, true) then return true end
                    end
                end
            end
        end
        return false
    end
    while isAlive and ScreenGui and ScreenGui.Parent do
        if AutoOpsEnabled then
            local now = tick()
            local elapsed = now - lastFire
            if elapsed >= RAND_OPS then
                local bossAlive = isBossAlive()
                if not bossAlive or elapsed >= FORCE_FIRE_TIMEOUT then
                    pcall(function()
                        local OpsRemote = ReplicatedStorage:FindFirstChild("OD_Remotes") and ReplicatedStorage.OD_Remotes:FindFirstChild("Ops")
                        if OpsRemote then
                            OpsRemote:FireServer("create", {
                                ["location"] = "CorpSpire",
                                ["conditions"] = {"GlassBody", "NoImplants"},
                                ["directive"] = "Boss"
                            })
                            InfoText.Text = "STATUS: REQUESTING OPS...\nWAITING FOR BOSS"
                        end
                    end)
                    lastFire = now
                else
                    InfoText.Text = "STATUS: BOSS ACTIVE\nWAITING FOR KILL..."
                end
            end
            task.wait(0.75)
        else
            task.wait(1)
        end
    end
end)

-- ==========================================
-- LOGIKA AUTO REPLAY RAID
-- ==========================================
task.spawn(function()
    local lastFire = 0
    while isAlive and ScreenGui and ScreenGui.Parent do
        if AutoRaidEnabled then
            local now = tick()
            if now - lastFire >= RAND_RAID then
                pcall(function()
                    local RaidChoiceRemote = ReplicatedStorage:FindFirstChild("OD_Remotes") and ReplicatedStorage.OD_Remotes:FindFirstChild("RaidChoice")
                    if RaidChoiceRemote then
                        RaidChoiceRemote:FireServer("again")
                        InfoText.Text = "STATUS: REPLAYING RAID..."
                    end
                end)
                lastFire = now
            end
            task.wait(0.5)
        else
            task.wait(1)
        end
    end
end)

-- ==========================================
-- LOGIKA AUTO OPEN CHEST
-- ==========================================
task.spawn(function()
    while isAlive and ScreenGui and ScreenGui.Parent do
        if AutoChestEnabled then
            pcall(function()
                local OD_Remotes = ReplicatedStorage:FindFirstChild("OD_Remotes")
                local CrateRemote = OD_Remotes and OD_Remotes:FindFirstChild("Crate")
                if CrateRemote then
                    for i = 1, 10 do CrateRemote:FireServer("chest", i) end
                    InfoText.Text = "STATUS: OPENING CHEST..."
                end
            end)
            task.wait(RAND_CHEST)
        else
            task.wait(1)
        end
    end
end)


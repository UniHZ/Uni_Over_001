-- Menyimpan source code ke variabel untuk di-queue saat teleport
local script_source = [==[
-- Anti-Detection: Delay acak per session
if not game:IsLoaded() then game.Loaded:Wait() end
if not getgenv().UniSc_SessionSeed then
    getgenv().UniSc_SessionSeed = math.random(1, 999999)
end
math.randomseed(getgenv().UniSc_SessionSeed + math.floor(tick()))
task.wait(0.15 + math.random() * 0.35)

local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Workspace = game:GetService("Workspace")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

-- Per-session randomized intervals (anti-detection)
local RAND_KILL = 0.18 + math.random() * 0.08
local RAND_ATTACK = 0.13 + math.random() * 0.07
local RAND_OPS = 2.3 + math.random() * 0.6
local RAND_RAID = 2.8 + math.random() * 0.6
local RAND_CHEST = 0.45 + math.random() * 0.15

-- FITUR PERSISTENCE
if getgenv().UniSc_Persistent then
    if getgenv().UniSc_GUI and not getgenv().UniSc_GUI.Parent then
        getgenv().UniSc_GUI.Parent = getGuiParent()
    end
    return
end
getgenv().UniSc_Persistent = true
getgenv().UniSc_CustomTargets = getgenv().UniSc_CustomTargets or {}

-- ==========================================
-- KONFIGURASI
-- ==========================================
local BossNames = { "ironvale sentinel", "black ice", "dragon lord", "the warden" }
local EnemyNames = { "ironvale drone", "ice ghost", "enemy", "mob", "helix trooper", "razorback", "boss" }
local MAX_DISTANCE = 130

for _, customName in ipairs(getgenv().UniSc_CustomTargets) do
    table.insert(BossNames, customName)
    table.insert(EnemyNames, customName)
end
-- ==========================================

local function getGuiParent()
    local success, hui = pcall(function() return gethui() end)
    if success and hui then return hui end
    local success2, core = pcall(function() return game:GetService("CoreGui") end)
    if success2 and core then return core end
    return LocalPlayer:WaitForChild("PlayerGui")
end

-- ========== THEMES ==========
local Themes = {
    ["Cyber Red"]     = {accent = Color3.fromRGB(255, 50, 50),  bg = Color3.fromRGB(10, 12, 16), bgLight = Color3.fromRGB(15, 18, 25), bgInput = Color3.fromRGB(20, 24, 30)},
    ["Neon Cyan"]     = {accent = Color3.fromRGB(0, 255, 255),  bg = Color3.fromRGB(6, 14, 20),  bgLight = Color3.fromRGB(10, 20, 30), bgInput = Color3.fromRGB(15, 28, 40)},
    ["Toxic Green"]   = {accent = Color3.fromRGB(0, 255, 100),  bg = Color3.fromRGB(6, 16, 10),  bgLight = Color3.fromRGB(10, 24, 15), bgInput = Color3.fromRGB(15, 32, 20)},
    ["Purple Void"]   = {accent = Color3.fromRGB(180, 80, 255), bg = Color3.fromRGB(12, 8, 20),  bgLight = Color3.fromRGB(18, 12, 30), bgInput = Color3.fromRGB(24, 16, 40)},
    ["Sunset Orange"] = {accent = Color3.fromRGB(255, 140, 0),  bg = Color3.fromRGB(20, 12, 8),  bgLight = Color3.fromRGB(30, 18, 12), bgInput = Color3.fromRGB(40, 24, 16)},
    ["Ice Blue"]      = {accent = Color3.fromRGB(100, 200, 255),bg = Color3.fromRGB(8, 12, 20),  bgLight = Color3.fromRGB(12, 18, 28), bgInput = Color3.fromRGB(18, 26, 38)},

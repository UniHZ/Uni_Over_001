end)

-- ==========================================
-- LOGIKA AUTO ATTACK (TELEPORT BEHIND + MELEE SPAM)
-- ==========================================
local function findTargetByPriority()
    local char = LocalPlayer.Character
    local myRoot = char and char:FindFirstChild("HumanoidRootPart")
    if not myRoot then return nil end
    local myPos = myRoot.Position
    local primaryNames = (AttackPriority == "BOSS") and BossNames or EnemyNames
    local fallbackNames = (AttackPriority == "BOSS") and EnemyNames or BossNames

    local function find(names)
        local best, bestD = nil, math.huge
        for _, obj in ipairs(Workspace:GetChildren()) do
            if obj.ClassName == "Model" then
                local hum = obj:FindFirstChildOfClass("Humanoid")
                if hum and hum.Health > 0 then
                    local nameLower = string.lower(obj.Name)
                    local matched = false
                    for _, n in ipairs(names) do
                        if string.find(nameLower, n, 1, true) then matched = true; break end
                    end
                    if matched then
                        local root = obj:FindFirstChild("HumanoidRootPart")
                        if root then
                            local d = (root.Position - myPos).Magnitude
                            if d < bestD and d <= MAX_DISTANCE then
                                bestD = d
                                best = obj
                            end
                        end
                    end
                end
            end
        end
        return best
    end

    return find(primaryNames) or find(fallbackNames)
end

task.spawn(function()
    local lastAttack = 0
    while isAlive and ScreenGui and ScreenGui.Parent do
        if AutoAttackEnabled then
            local now = tick()
            if now - lastAttack >= RAND_ATTACK then
                local char = LocalPlayer.Character
                local myRoot = char and char:FindFirstChild("HumanoidRootPart")
                if myRoot then
                    local target = findTargetByPriority()
                    if target then
                        local npcRoot = target:FindFirstChild("HumanoidRootPart")
                        if npcRoot then
                            -- Teleport behind NPC, facing same direction (facing NPC's back)
                            pcall(function()
                                local behindPos = npcRoot.Position
                                    - npcRoot.CFrame.LookVector * 3.2
                                    + Vector3.new(0, 1.2, 0)
                                myRoot.CFrame = CFrame.new(behindPos, behindPos + npcRoot.CFrame.LookVector)
                            end)
                            -- Fire melee
                            pcall(function()
                                local CombatRemote = ReplicatedStorage:FindFirstChild("OD_Remotes")
                                    and ReplicatedStorage.OD_Remotes:FindFirstChild("Combat")
                                if CombatRemote then
                                    CombatRemote:FireServer("light")
                                    CombatRemote:FireServer("hit", {target})
                                end
                            end)
                            -- Activate held tool as backup
                            pcall(function()
                                local tool = char:FindFirstChildOfClass("Tool")
                                if tool then tool:Activate() end
                            end)
                            InfoText.Text = "STATUS: AUTO ATTACK\nTARGET: " .. target.Name
                        end
                    else
                        InfoText.Text = "STATUS: AUTO ATTACK\nNO TARGET IN RANGE"
                    end
                end
                lastAttack = now
            end
            task.wait(0.05)
        else
            task.wait(0.5)
        end
    end
end)

-- ==========================================
-- LOGIKA INSTANT KILL (OPTIMIZED)
-- ==========================================
task.spawn(function()
    local SCAN_INTERVAL = RAND_KILL
    local cachedChar = nil
    local cachedRoot = nil
    local lastStatus = ""

    while isAlive and ScreenGui and ScreenGui.Parent do
        task.wait(SCAN_INTERVAL + math.random() * 0.06)

        if not (AutoKillBossEnabled or AutoKillEnemyEnabled) then
            cachedChar = nil
            cachedRoot = nil
            task.wait(0.5)
        else
            if cachedChar ~= LocalPlayer.Character or (cachedRoot and not cachedRoot.Parent) then
                cachedChar = LocalPlayer.Character
                cachedRoot = cachedChar and cachedChar:FindFirstChild("HumanoidRootPart")
            end

            if cachedRoot then
                local myPos = cachedRoot.Position
                local found = false

                local function tryKill(obj)
                    if obj.ClassName ~= "Model" then return false end
                    local hum = obj:FindFirstChildOfClass("Humanoid")
                    if not hum or hum.Health <= 0 then return false end
                    local nameLower = string.lower(obj.Name)
                    local targetType = nil
                    if AutoKillBossEnabled then
                        for _, bName in ipairs(BossNames) do
                            if string.find(nameLower, bName, 1, true) then targetType = "BOSS"; break end
                        end
                    end
                    if not targetType and AutoKillEnemyEnabled then
                        for _, eName in ipairs(EnemyNames) do
                            if string.find(nameLower, eName, 1, true) then targetType = "NPC"; break end
                        end
                    end
                    if not targetType then return false end
                    local targetRoot = obj:FindFirstChild("HumanoidRootPart")
                        or obj.PrimaryPart or obj:FindFirstChild("Head")
                    if not targetRoot then return false end
                    local distance = (targetRoot.Position - myPos).Magnitude
                    if distance > MAX_DISTANCE then return false end
                    pcall(function() hum.Health = 0 end)
                    pcall(function() hum:TakeDamage(999999999) end)
                    pcall(function()
                        local tool = cachedChar:FindFirstChildOfClass("Tool")
                        if tool then tool:Activate() end
                    end)
                    InfoText.Text = "STATUS: KILLED " .. targetType .. "\nTARGET: " .. obj.Name .. "\nDIST: " .. math.floor(distance) .. " STUDS"
                    return true
                end

                for _, obj in ipairs(Workspace:GetChildren()) do
                    local className = obj.ClassName
                    if className == "Model" then
                        if tryKill(obj) then found = true; break end
                    elseif className == "Folder" then
                        local children = obj:GetChildren()
                        if #children > 0 then
                            for _, sub in ipairs(children) do
                                if sub.ClassName == "Model" and tryKill(sub) then
                                    found = true
                                    break
                                end
                            end
                        end
                        if found then break end
                    end
                end

                if not found and not AutoOpsEnabled then
                    local newStatus = "STATUS: SCANNING (<= " .. MAX_DISTANCE .. " STUDS)...\nNO TARGETS IN RANGE"
                    if lastStatus ~= newStatus then
                        InfoText.Text = newStatus
                        lastStatus = newStatus
                    end
                end
            end
        end
    end
end)

-- ==========================================
-- ANIMASI UI (PULSE ACCENT)
-- ==========================================
RunService.Heartbeat:Connect(function()
    if not isAlive or not ScreenGui or not ScreenGui.Parent then return end
    local pulse = 0.5 + 0.5 * math.sin(tick() * 2.2)
    local darker = Theme.accent:Lerp(Color3.new(0, 0, 0), 0.55)
    local c = darker:Lerp(Theme.accent, pulse)
    pcall(function() UIStroke.Color = c end)
end)


    local f = Instance.new("Frame")
    f.Size = UDim2.new(1, -20, 0, 210)
    f.Position = UDim2.new(0, 10, 0, 72)
    f.BackgroundTransparency = 1
    f.Visible = (i == 1)
    f.Parent = MainFrame
    tabContents[i] = f
end

local function setActiveTab(idx)
    activeTab = idx
    for i, btn in ipairs(tabButtons) do
        if i == idx then
            btn.BackgroundColor3 = Theme.accent
            btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        else
            btn.BackgroundColor3 = Theme.bgInput
            btn.TextColor3 = Color3.fromRGB(150, 150, 150)
        end
        tabContents[i].Visible = (i == idx)
    end
end

for i, btn in ipairs(tabButtons) do
    btn.MouseButton1Click:Connect(function() setActiveTab(i) end)
end
setActiveTab(1)

